# Keep contextual AI disabled unless you explicitly opt in.
RAC_CONTEXTUAL_AI_ENABLED=false

# Keep any future live model verification path disabled by default.
RAC_AI_LIVE_TEST_ENABLED=false

# Server-only credentials. Configure these in backend/.env, not this template.
# Keep blank; never commit or paste real credentials into this file.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional persistent AI job ledger path.
# RAC_AI_BATCH_LEDGER_FILE=
