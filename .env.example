# Copy this file to backend/.env. Keep all API keys server-side.

RAC_AI_ENABLED=0
RAC_AI_MODEL=gemini-3.8-flash
RAC_AI_CONCURRENCY=2
RAC_AI_REQUESTS_PER_MINUTE=5
RAC_AI_TOKENS_PER_MINUTE=20000
RAC_AI_DAILY_TOKEN_BUDGET=250000
RAC_AI_DAILY_REQUEST_BUDGET=50
RAC_AI_BUDGET_WARNING_RATIO=0.8
RAC_AI_MAX_OUTPUT_TOKENS=192
RAC_AI_TIMEOUT_MS=30000
RAC_AI_MAX_RETRIES=2
RAC_AI_CACHE_TTL_MS=43200000

# Only configure the key for the selected model's provider.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
